# Database
DATABASE_URL="postgresql://user:password@localhost:5432/solace_bay_resort?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Razorpay
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="xxxxxxxxxxxxxxx"
CLOUDINARY_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Solace Bay Resort <reservations@solacebayresort.com>"

# Hotel default admin (used only by the seed script)
SEED_ADMIN_EMAIL="admin@solacebayresort.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# n8n / automation webhook (outbound)
N8N_WEBHOOK_URL="https://your-n8n-instance/webhook/solace-bay"
